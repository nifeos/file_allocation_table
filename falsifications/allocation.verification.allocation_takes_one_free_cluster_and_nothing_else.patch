Falsifies `file_allocation_table::allocation::verification::allocation_takes_one_free_cluster_and_nothing_else`.

The defect: the search treats a reserved entry as free, so it hands out a cluster the specification keeps out of every chain.

Expected to fail: the harness's `assert_eq!(before[taken], TableEntry::Free)`.

diff --git a/src/allocation.rs b/src/allocation.rs
--- a/src/allocation.rs
+++ b/src/allocation.rs
@@ -78,7 +78,7 @@ pub(crate) fn find_free<L: Links>(
     for step in 0..clusters {
         // `start < clusters` and `step < clusters`, so the sum cannot reach 2 * clusters + 2.
         let cluster = 2 + (start + step) % clusters;
-        if links.table_entry(cluster)? == TableEntry::Free {
+        if matches!(links.table_entry(cluster)?, TableEntry::Free | TableEntry::Reserved) {
             return Ok(Some(cluster));
         }
     }
